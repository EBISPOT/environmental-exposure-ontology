AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9000079> "exposure to white glue")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9000079> "exposure to wood glue")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9000099> "exposure to isopropanol")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9000099> "exposure to isopropyl alcohol")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9000099> "exposure to rubbing alcohol")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9001302> "exposure to vinyl chloride")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9001538> "exposure to PBB")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_9001538> "exposure to polybrominated biphenyl")

# Class: <http://purl.obolibrary.org/obo/ECTO_0000992> (exposure to European diet)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000992> "A dietary exposure in which the diet consumed follows a European dietary pattern.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000992> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0000992> "Requested for GWAS Catalog gene-environment interaction traits (727 study rows). An ONS European diet class did not exist at creation time; if one is added this term should be migrated to the exposure_to_diet DOSDP pattern.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000992> "exposure to European diet")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000992> <http://purl.obolibrary.org/obo/ECTO_0000985>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000993> (exposure to Japanese diet)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000993> "A dietary exposure in which the diet consumed follows a Japanese dietary pattern.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000993> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_0000993> "exposure to Washoku")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0000993> "Requested for GWAS Catalog gene-environment interaction traits (738 study rows). An ONS Japanese diet class did not exist at creation time; if one is added this term should be migrated to the exposure_to_diet DOSDP pattern.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000993> "exposure to Japanese diet")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000993> <http://purl.obolibrary.org/obo/ECTO_0000985>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000994> (exposure to season of birth)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000994> "An exposure event in which the exposure stimulus is the set of environmental conditions associated with the season of the year during which the exposure receptor was born.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000994> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0000994> "Grouping class for season-of-birth exposures reported as gene-environment interaction factors (e.g. GWAS Catalog microbiome GxE traits).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000994> "exposure to season of birth")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000994> <http://purl.obolibrary.org/obo/ExO_0000002>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000995> (exposure to birth in spring)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000995> "A season of birth exposure in which the exposure receptor was born during spring.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000995> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000995> "exposure to birth in spring")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000995> <http://purl.obolibrary.org/obo/ECTO_0000994>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000996> (exposure to birth in summer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000996> "A season of birth exposure in which the exposure receptor was born during summer.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000996> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000996> "exposure to birth in summer")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000996> <http://purl.obolibrary.org/obo/ECTO_0000994>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000997> (exposure to birth in autumn)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000997> "A season of birth exposure in which the exposure receptor was born during autumn.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000997> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ECTO_0000997> "exposure to birth in fall")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000997> "exposure to birth in autumn")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000997> <http://purl.obolibrary.org/obo/ECTO_0000994>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000998> (exposure to birth in winter)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000998> "A season of birth exposure in which the exposure receptor was born during winter.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000998> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000998> "exposure to birth in winter")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000998> <http://purl.obolibrary.org/obo/ECTO_0000994>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0000999> (exposure to sleep)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0000999> "An exposure event in which the exposure stimulus is the sleep behavior of the exposure receptor, including its duration and timing.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0000999> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0000999> "Defined on GO:0030431 'sleep', mirroring the construction of 'exposure to behavioral process'. Requested for GWAS sleep-duration gene-environment interaction traits; ECTO previously had no sleep vocabulary.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0000999> "exposure to sleep")
EquivalentClasses(<http://purl.obolibrary.org/obo/ECTO_0000999> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/ExO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002309> <http://purl.obolibrary.org/obo/GO_0030431>)))
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0000999> <http://purl.obolibrary.org/obo/ECTO_0000989>)


# Class: <http://purl.obolibrary.org/obo/ECTO_0001000> (exposure to cesarean section delivery)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECTO_0001000> "An exposure to a medical action in which the exposure receptor is delivered by cesarean section.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/ECTO_0001000> <https://ai4curation.github.io/aidocs/reference/clients/claude-code/>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0001000> "Delivery-mode exposure of the newborn (NCIT:C46088 Cesarean Section). Requested for early-life microbiome gene-environment interaction traits.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0001000> "exposure to cesarean section delivery")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0001000> <http://purl.obolibrary.org/obo/ECTO_2000000>)


