AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ECTO_0001001> "Delivery-mode exposure of the newborn (NCIT:C81303 Vaginal Delivery), sibling of exposure to cesarean section delivery.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECTO_0001001> "exposure to vaginal delivery")
SubClassOf(<http://purl.obolibrary.org/obo/ECTO_0001001> <http://purl.obolibrary.org/obo/ECTO_2000000>)


